\newcommand*\passignsetup[1]{\pgfkeys{/passign/.cd,#1}}
\newcommand*\showsolutions{\passignsetup{solutions=show}}
\newcommand*\hidesolutions{\passignsetup{solutions=hide}}

% package options: `solutions', `nosolutions', or any key=value
\DeclareOption{solutions}{\passign@solutionstrue}
\DeclareOption{nosolutions}{\passign@solutionsfalse}
\DeclareOption*{%
  \edef\passign@tmp{\noexpand\pgfkeys{/passign/.cd,\CurrentOption}}%
  \passign@tmp}
\ProcessOptions\relax

% \title and \author are shortcuts for the keys of the same name
\renewcommand*\title[1]{\gdef\@title{#1}\gdef\passign@opt@title{#1}}
\renewcommand*\author[1]{\gdef\@author{#1}\gdef\passign@opt@author{#1}}


