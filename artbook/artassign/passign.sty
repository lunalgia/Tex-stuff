%% ======================================================================
%%  passign.sty  v1.0  --  print-on-demand-catalogue style assignments
%%
%%  A sibling of ptoc.sty for homework / assignment submissions.  It keeps
%%  the visual grammar of ptoc -- the label column left of a hairline
%%  divider, hairlines that break around the divider, small mono labels,
%%  boxed theorems, margin notes, and the accent-coloured bar in the outer
%%  margin that carries the page number and a vertical running text -- but
%%  drops the book structure (no parts, chapters, table of contents).
%%
%%  Requires LuaLaTeX or XeLaTeX (fontspec), and any ordinary class
%%  (article, report, book).  Load `geometry' BEFORE this package: the
%%  geometry you set is the full block that the grid is drawn on.  The
%%  outer (right) margin of that geometry is where the accent bar goes.
%%  Build twice if you use marks (the total is read back from the .aux).
%%
%%  What a page looks like
%%  ----------------------
%%  \maketitle       a header grid on the first page: the assignment label
%%                   and a huge accent-coloured number in the label column,
%%                   the title to the right; below, one row per piece of
%%                   metadata (course, name, student id, instructor, due
%%                   date, total marks, and any fields you add).
%%  question         the structural unit.  A hairline across the page
%%                   (broken around the divider), the label QUESTION 3 and
%%                   the marks in the label column, an optional title.
%%  solution         the same label column (SOLUTION 3), a tinted block
%%                   on the divider, and a small accent square at the end.
%%                   Can be hidden for a question-only copy.
%%  \section         optional grouping of questions (Section A, B ...),
%%                   styled like a ptoc section.  It does not change the
%%                   numbering of the questions.
%%
%%  Commands
%%     \passignsetup{key=value, ...}   configure (keys below)
%%     \title{..} \author{..}          shortcuts for the keys of that name
%%     \maketitle                      the title block (alias \makeassignmenttitle)
%%     \addtitlefield{Label}{Value}    one more row in the title block
%%     \showsolutions  \hidesolutions  same as  solutions = show / hide
%%     \totalmarks                     the total of all marks given so far
%%                                     (needs a second run)
%%     \marginnote[offset]{text}       unnumbered note in the label column
%%     \sidenote[offset]{text}         numbered note in the label column
%%                                     (offset: + moves down, - moves up)
%%
%%  Package options
%%     solutions / nosolutions         show (default) or hide the solutions
%%     key=value                       anything \passignsetup understands
%%
%%  Environments
%%     question[options]               a numbered question.  Options:
%%                                       marks = 5     marks for the question
%%                                       title = ...   a title (bold, serif)
%%                                       label = ...   replaces the word
%%                                                     "Question" (e.g. Bonus)
%%                                     A bare value is taken as the marks:
%%                                     \begin{question}[5]  =  [marks=5].
%%                                     Marks may be an expression: [3+2].
%%     question*                       an unnumbered question (same options)
%%     parts, subparts                 inside a question:
%%                                       \begin{parts}
%%                                         \part[4] ...   % (a), 4 marks
%%                                         \part    ...   % (b)
%%                                           \begin{subparts}
%%                                             \subpart[2] ...   % (i)
%%                                           \end{subparts}
%%                                       \end{parts}
%%     solution[Title]                 the solution.  The optional title is
%%                                     run into the text, in bold.  Put the
%%                                     \end{solution} on a line of its own;
%%                                     it may be indented.
%%
%%  Theorem-like environments (amsthm, defined at \begin{document})
%%     theorem  lemma                  italic, in a square box
%%     definition                      upright, in a square box
%%     proposition  corollary          italic, no box
%%     example  remark  hint  note     upright, no box
%%     proof                           labelled in the column
%%     Each also exists unnumbered:  theorem*  lemma*  remark*  hint*  ...
%%     All numbered ones share one counter, reset in every question, so
%%     they read REMARK 3.2.  The name and number stand in the label
%%     column; the optional title  \begin{remark}[Title]  stays in the
%%     text, in bold.  Use the starred forms outside a question.
%%     `theorems = off' skips all of this.
%%
%%  Keys (defaults in brackets)
%%   assignment   course            course name                         []
%%                course code       e.g. MATH 2210                      []
%%                number            assignment number                   []
%%                title             assignment title                    []
%%                author            your name                           []
%%                student id        your student number                 []
%%                instructor        instructor / grader                 []
%%                term              e.g. Autumn 2026                    []
%%                due               due date                            []
%%   words        assignment label  [Assignment]    question label   [Question]
%%                solution label    [Solution]      section label    [Section]
%%                course label      [Course]        author label     [Name]
%%                id label          [Student ID]    instructor label [Instructor]
%%                term label        [Term]          due label        [Due]
%%                total label       [Total]
%%                mark word         [mark]          marks word       [marks]
%%   solutions    solutions         show | hide                         [show]
%%                solution style    tint | box | plain                  [tint]
%%                solution number   true | false: number in the label   [true]
%%                solution tint     percentage of the accent colour     [14]
%%                solution space    blank space left by a hidden        [0pt]
%%                                  solution (room to write by hand)
%%   layout       rule              rule thickness                      [0.5pt]
%%                rule gap          white gap each side of the divider  [0.8mm]
%%                label pad         space between label and divider     [2mm]
%%                body split        x of the divider (= width of the    [0.25\textwidth]
%%                                  label column)
%%                body gap          space between divider and text      [5mm]
%%                body right        space between text and the outer    [6mm]
%%                                  margin strip
%%                body top          extra space above the text          [6mm]
%%                body bottom       extra space below the text          [10mm]
%%                body leading      \linespread                         [1.2]
%%   title block  title before      space between rule and title        [3mm]
%%                title after       space between title and next rule   [4mm]
%%                meta sep          space between metadata rows         [1.6mm]
%%                title skip        space after the block               [7mm]
%%   questions    question before / question after / question pad
%%                part skip         space above a (a), (b) ...          [0.5\baselineskip ...]
%%                subpart skip      space above a (i), (ii) ...         [0.3\baselineskip ...]
%%                subpart indent    indent of a subpart                 [1.2em]
%%                subpart label width                                   [2.1em]
%%                solution before / solution after
%%   sections     section pad / section before / section after
%%   margin       margin text       running text, any code              [course code and
%%                                  (empty = the title)                  assignment]
%%                footer text       text under the label column         [name, student id]
%%                margin gap        space between number and text       [6mm]
%%                margin shift      move both towards the paper edge    [0pt]
%%                margin bar width  auto | a length | none              [auto]
%%                label case        \MakeUppercase, or empty            [\MakeUppercase]
%%   notes        note gap          space between notes and the divider [4mm]
%%                footnotes         margin | normal                     [margin]
%%                footnote font     applied to the text of footnotes    [\itshape]
%%   theorems     theorems          on | off                            [on]
%%                theorem head font / theorem title font
%%                theorem box sep   space between box and text          [2.5mm]
%%                theorem skip      space above and below               [9pt plus 2pt minus 2pt]
%%   colours      accent            bar, big number, tint, qed square   [#FFC400]
%%                ink               rules, qed outline, theorem boxes   [#1F1B1D]
%%                number colour     numbers in the label column         [ink]
%%   fonts        each is arbitrary code that switches font, usually
%%                \fontspec[Ligatures=TeX]{...} then \fontsize{..}{..}\selectfont
%%                label font        small mono labels                   [mono 5.6pt]
%%                part label font   (a), (b) in the label column        [mono 7pt]
%%                subpart label font                                    [mono 7pt]
%%                title font        the title in the title block        [serif 26pt]
%%                number font       the huge assignment number          [sans 54pt]
%%                question title font                                   [bold serif 11pt]
%%                section font / section number font / subsection font
%%                margin font / margin page font / note font
%% ======================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{passign}[2026/10/02 v1.0 print-on-demand style assignments]

\RequirePackage{fontspec}
\RequirePackage{xcolor}
\RequirePackage{pgfkeys}
\RequirePackage{graphicx}   % \rotatebox for the margin text, \raisebox
\RequirePackage{amsthm}     % theorem-like environments, the end-of-solution mark
\RequirePackage{mdframed}   % boxes around theorems, the tint behind solutions
\RequirePackage{verbatim}   % skips hidden solutions (no restrictions on content)

\newif\ifpassign@solutions \passign@solutionstrue
\newif\ifpassign@solnumber \passign@solnumbertrue
\newif\ifpassign@qm        % the current question has marks of its own
\newif\ifpassign@pm        % the current part has marks of its own


