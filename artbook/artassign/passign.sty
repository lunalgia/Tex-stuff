% Default fonts (TeX Gyre ships with TeX Live; fall back to the standard
% families if it is missing).  Replace them freely via the font keys.
\newcommand*\passign@sans{%
  \IfFontExistsTF{TeX Gyre Heros}{\fontspec[Ligatures=TeX]{TeX Gyre Heros}}{\sffamily}%
  \bfseries}
\newcommand*\passign@serif{%
  \IfFontExistsTF{TeX Gyre Pagella}{\fontspec[Ligatures=TeX]{TeX Gyre Pagella}}{\rmfamily}}
\newcommand*\passign@mono{%
  \IfFontExistsTF{TeX Gyre Cursor}%
    {\fontspec[Ligatures=TeX,LetterSpace=12]{TeX Gyre Cursor}}{\ttfamily}}

% default running text / footer text (see `margin text', `footer text')
\newcommand*\passign@defaultmargin{%
  \passign@opt@coursecode
  \ifx\passign@opt@coursecode\@empty\else
    \ifx\passign@opt@number\@empty\else\space\textperiodcentered\space\fi
  \fi
  \ifx\passign@opt@number\@empty\else
    \passign@opt@assignmentlabel\nobreakspace\passign@opt@number
  \fi}
\newcommand*\passign@defaultfooter{%
  \passign@opt@author
  \ifx\passign@opt@author\@empty\else
    \ifx\passign@opt@studentid\@empty\else\space\textperiodcentered\space\fi
  \fi
  \passign@opt@studentid}

