\newlength\passign@rule    % rule thickness
\newlength\passign@gap     % white gap on each side of the divider
\newlength\passign@fulltw  % full text width (the grid)
\newlength\passign@bodytw  % body text width
\newlength\passign@fullth  % full text height
\newlength\passign@fulltopm
\newlength\passign@fullodd
\newlength\passign@fulleven
\newlength\passign@bodyleft
\newlength\passign@bodyright
\newlength\passign@bodytop
\newlength\passign@bodybot
\newlength\passign@bsplit  % x of the divider (from the full block)
\newlength\passign@bodygap % space between the divider and the text
\newlength\passign@fr      % distance from the header baseline to the footer rule
\newlength\passign@mw      % width of the outer margin
\newlength\passign@mx      % x of the centre line of the outer margin text
\newlength\passign@bx      % x of the centre line of the outer margin strip
\newlength\passign@bw      % width of the margin bar
\newlength\passign@bh      % distance from the paper top to the header baseline
\newdimen\passign@pos      % helpers of \passign@gaprulew
\newdimen\passign@cur
\newdimen\passign@cutl
\newdimen\passign@cutr
\newbox\passign@nbox \newbox\passign@mbox \newbox\passign@rbox
\newbox\passign@bxa \newbox\passign@bxb

\def\passign@str@auto{auto}
\def\passign@str@none{none}
\def\passign@str@off{off}
\def\passign@str@margin{margin}
\def\passign@str@tint{tint}
\def\passign@str@box{box}
\def\passign@str@one{1}
\def\passign@str@zero{0}

% A small label: label font, optionally upper-cased.
\newcommand*\passign@label[1]{{\passign@opt@fontlabel\passign@opt@case{#1}}}

% Rectangles made of rules.
\newcommand*\passign@hbar[1]{\vrule width#1 height\passign@rule depth\z@}

% A horizontal rule from x=#2 to x=#3 (an \hbox of width #1) that leaves a
% small white gap on both sides of every vertical line listed in #4
% (ascending x, a comma list of lengths, each line \passign@rule wide).
% Where a vertical line passes through, a rule-sized square keeps it
% unbroken.  (This is the rule of ptoc's table of contents.)
\def\passign@dseg#1#2{%
  \ifdim#2>#1\relax
    \hskip\dimexpr#1-\passign@pos\relax
    \passign@hbar{\dimexpr#2-#1\relax}%
    \passign@pos=#2\relax
  \fi}
\newcommand*\passign@gaprulew[4]{%       % #1 = width of the box
  \hbox to#1{%
    \passign@pos=\z@ \passign@cur=#2\relax
    \@for\passign@v:=#4\do{%
      \passign@cutl=\dimexpr\passign@v-\passign@gap\relax
      \passign@cutr=\dimexpr\passign@v+\passign@rule+\passign@gap\relax
      \ifdim\passign@cutr>\passign@cur\relax
        \ifdim\passign@cutl>#3\relax
          \passign@dseg{\passign@cur}{#3}%
        \else
          \passign@dseg{\passign@cur}{\passign@cutl}%
        \fi
        \passign@cur=\passign@cutr\relax
      \fi
      \ifdim\passign@v<#3\relax
        \passign@dseg{\passign@v}{\dimexpr\passign@v+\passign@rule\relax}%
      \fi}%
    \passign@dseg{\passign@cur}{#3}%
    \hfil}}

% The hairline across the whole block (broken around the divider), as a
% zero-width box so that it can sit in the text column.
\newcommand*\passign@hrule{%
  \nointerlineskip
  \hbox to\z@{\hskip-\passign@bodyleft
    \passign@gaprulew{\passign@fulltw}{\z@}{\passign@fulltw}{\passign@bsplit}\hss}%
  \nointerlineskip}


%% ----------------------------------------------------------------------
%%  3. Full block / body block geometry
%%
%%  The geometry the user sets is the FULL block.  Pages are set in a
%%  smaller, "airy" block inside it (more room above, below and to the
%%  left, room for the label column).
%% ----------------------------------------------------------------------
\newcommand*\passign@settextwidth[1]{%
  \setlength\textwidth{#1}\setlength\columnwidth{#1}%
  \setlength\linewidth{#1}\hsize=#1\relax}
\newcommand*\passign@bodylayout{%
  \passign@settextwidth{\passign@bodytw}%
  \setlength\textheight{\dimexpr\passign@fullth-\passign@bodytop-\passign@bodybot\relax}%
  \setlength\topmargin{\dimexpr\passign@fulltopm+\passign@bodytop\relax}%
  \setlength\oddsidemargin{\dimexpr\passign@fullodd+\passign@bodyleft\relax}%
  \setlength\evensidemargin{\dimexpr\passign@fulleven+\passign@bodyleft\relax}%
  \global\@colht\textheight \global\@colroom\@colht
  \vsize\@colroom
  \linespread{\passign@opt@bodyleading}\selectfont}
% left / right paper margin of the FULL layout on the page being shipped
\newcommand*\passign@fullside{%
  \if@twoside\ifodd\c@page\passign@fullodd\else\passign@fulleven\fi
  \else\passign@fullodd\fi}


%% ----------------------------------------------------------------------
%%  4. The label column
%% ----------------------------------------------------------------------
% A label in the column left of the divider: right-aligned, flush against
% the divider, zero width, first baseline on the baseline of the text.
% #1 = font switch, #2 = word (may be empty), #3 = number (may be empty),
% #4 = a MACRO holding a second line (\@empty for none), e.g. the marks.
% The label never wraps wider than the column.
\DeclareRobustCommand*\passign@leftlabelm[4]{%
  \protected@edef\passign@tmpa{#2}\protected@edef\passign@tmpb{#3}%
  \llap{%
    \vtop{\everypar{}% (a paragraph in here must not fire amsthm's \everypar)
      \hsize=\dimexpr\passign@bsplit-\passign@pad\relax
      \raggedleft \parindent\z@ \normalfont #1%
      \ifx\passign@tmpa\@empty\else
        \passign@opt@case{#2}%
        \ifx\passign@tmpb\@empty\else\nobreakspace\fi
      \fi
      \ifx\passign@tmpb\@empty\else{\color{passign@num}#3}\fi
      \par
      \ifx#4\@empty\else
        \nointerlineskip\vskip 0.9mm
        {\color{passign@ink!60}#4}\par
      \fi}%
    \hskip\dimexpr\passign@bodyleft-\passign@bsplit+\passign@pad\relax}}
\DeclareRobustCommand*\passign@leftlabel[3]{\passign@leftlabelm{#1}{#2}{#3}\@empty}

% Marks.  #1 is a macro holding the marks (possibly empty); the result,
% "5 MARKS" (or \@empty), is left in \passign@marksout.
\newcommand*\passign@mkmarks[1]{%
  \ifx#1\@empty
    \let\passign@marksout\@empty
  \else
    \edef\passign@marksout{\noexpand\passign@opt@case{#1\noexpand\nobreakspace
      \ifx#1\passign@str@one\passign@opt@markword\else\passign@opt@markswords\fi}}%
  \fi}

% Total marks.  Every question (or, if it has none, its parts, or their
% subparts) adds to the total, which is written to the .aux and can be
% printed with \totalmarks on the next run.  Marks may be any number or
% arithmetic expression:  [5]  [2.5]  [3+2].
\gdef\passign@totalmarks{0}
\gdef\passign@lasttotal{0}
\ExplSyntaxOn
\cs_new_protected:Npn \passign@addmarks #1
  { \xdef \passign@totalmarks { \fp_to_decimal:n { \passign@totalmarks + (#1) } } }
\ExplSyntaxOff
\newcommand*\totalmarks{\passign@lasttotal}
\AtEndDocument{%
  \if@filesw
    \immediate\write\@auxout{\string\gdef\string\passign@lasttotal{\passign@totalmarks}}%
  \fi}


%% ----------------------------------------------------------------------
%%  5. Questions, parts, subparts
%%
%%      ------------------+-----------------------------   hairline, broken
%%                QUESTION 3| Title of the question          around the divider
%%                  5 MARKS |
%%
%%  The label stands in the column, flush against the divider, the number
%%  in the number colour, the marks in a second line.  A question has no
%%  indented first paragraph.
%% ----------------------------------------------------------------------
\newcounter{question}
\renewcommand\thequestion{\arabic{question}}
\newcounter{qpart}
\renewcommand\theqpart{\alph{qpart}}
\newcounter{qsubpart}
\renewcommand\theqsubpart{\roman{qsubpart}}
\def\passign@curqnum{}

\pgfkeys{/passign/q/.cd,
  title/.store in = \passign@q@title,
  marks/.store in = \passign@q@marks,
  label/.store in = \passign@q@label,
  .unknown/.code  = {\edef\passign@q@marks{\pgfkeyscurrentname}},
}

% #1 = 1 for a numbered question, 0 for question*;  #2 = the options
\newcommand*\passign@qbegin[2]{%
  \par
  \let\passign@q@title\@empty \let\passign@q@marks\@empty
  \let\passign@q@label\@empty
  \pgfkeys{/passign/q/.cd,#2}%
  \addvspace{\passign@opt@qbefore}%
  \ifnum#1>\z@
    \refstepcounter{question}%
    \edef\passign@curqnum{\thequestion}%
  \else
    % unnumbered: its own little numbering for theorems and remarks
    \def\passign@curqnum{}%
    \@ifundefined{c@theorem}{}{\setcounter{theorem}{0}\def\thetheorem{\arabic{theorem}}}%
  \fi
  \setcounter{qpart}{0}\setcounter{qsubpart}{0}%
  \ifx\passign@q@label\@empty
    \let\passign@qword\passign@opt@questionlabel
  \else
    \let\passign@qword\passign@q@label
  \fi
  \ifx\passign@q@marks\@empty
    \global\passign@qmfalse
  \else
    \global\passign@qmtrue \passign@addmarks{\passign@q@marks}%
  \fi
  \global\passign@pmfalse
  \passign@mkmarks\passign@q@marks
  % hairline, then the label (and the title) on the first line
  \passign@hrule
  \nobreak\vskip\passign@opt@qpad \nointerlineskip
  \ifx\passign@q@title\@empty
    \noindent
    \passign@leftlabelm{\passign@opt@fontlabel}{\passign@qword}{\passign@curqnum}\passign@marksout
    \ignorespaces
  \else
    \noindent
    \passign@leftlabelm{\passign@opt@fontlabel}{\passign@qword}{\passign@curqnum}\passign@marksout
    {\passign@opt@fontqtitle \raggedright \passign@q@title\par}%
    \nobreak\vskip 0.8\baselineskip
    \@afterindentfalse\@afterheading
  \fi}
\newcommand*\passign@qend{\par\addvspace{\passign@opt@qafter}}

\newenvironment{question}[1][]{\passign@qbegin{1}{#1}}{\passign@qend}
\newenvironment{question*}[1][]{\passign@qbegin{0}{#1}}{\passign@qend}

% \part[marks]: (a) in the label column, the marks under it
\newcommand\passign@part[1][]{%
  \par\addvspace{\passign@opt@partskip}%
  \stepcounter{qpart}\setcounter{qsubpart}{0}%
  \def\passign@pmv{#1}%
  \ifx\passign@pmv\@empty
    \global\passign@pmfalse
  \else
    \global\passign@pmtrue
    \ifpassign@qm\else\passign@addmarks{\passign@pmv}\fi
  \fi
  \passign@mkmarks\passign@pmv
  \noindent
  \passign@leftlabelm{\passign@opt@fontpartlabel}{}{(\theqpart)}\passign@marksout
  \ignorespaces}
% \subpart[marks]: (i), hanging, marks inline
\newcommand\passign@subpart[1][]{%
  \par\addvspace{\passign@opt@subpartskip}%
  \stepcounter{qsubpart}%
  \def\passign@pmv{#1}%
  \ifx\passign@pmv\@empty\else
    \ifpassign@qm\else\ifpassign@pm\else\passign@addmarks{\passign@pmv}\fi\fi
  \fi
  \passign@mkmarks\passign@pmv
  \hangindent=\dimexpr\passign@opt@subindent+\passign@opt@sublabelw\relax
  \hangafter=1\relax
  \noindent\hskip\passign@opt@subindent
  \hbox to\passign@opt@sublabelw{{\passign@opt@fontsublabel\color{passign@num}(\theqsubpart)}\hss}%
  \ifx\passign@pmv\@empty\else
    {\passign@opt@fontlabel\color{passign@ink!60}\passign@marksout}\ %
  \fi
  \ignorespaces}
\newenvironment{parts}{\par\setcounter{qpart}{0}\let\part\passign@part}{\par}
\newenvironment{subparts}{\par\setcounter{qsubpart}{0}\let\subpart\passign@subpart}{\par}


%% ----------------------------------------------------------------------
%%  6. Solutions
%%
%%  Shown:   the label SOLUTION 3 in the column, an optional bold title run
%%           into the text, a tint on the divider (or a box, or nothing),
%%           and a small accent square flush right at the end.
%%  Hidden:  skipped as the `comment' environment of verbatim.sty skips
%%           its contents -- anything may be inside, and the \end line may
%%           be indented -- optionally leaving `solution space' blank.
%%  Chosen at \begin{document}, after \passignsetup has been read.
%% ----------------------------------------------------------------------
\newcommand*\passign@qedsquare{%
  \begingroup
    \fboxsep=\z@ \fboxrule=\passign@rule
    \fcolorbox{passign@ink}{passign@accent}{\vrule width 0.9ex height 0.9ex depth\z@}%
  \endgroup}

\newcommand*\passign@definehiddensolution{%
  \def\solution{%
    \@bsphack
    \let\do\@makeother\dospecials\catcode`\^^M\active
    \let\verbatim@startline\relax
    \let\verbatim@addtoline\@gobble
    \let\verbatim@processline\relax
    \let\verbatim@finish\relax
    \verbatim@}%
  \def\endsolution{%
    \@esphack
    \par\ifdim\passign@opt@solspace>\z@ \vspace*{\passign@opt@solspace}\fi}}

\newcommand*\passign@definevisiblesolution{%
  \colorlet{passign@soltint}{passign@accent!\passign@opt@soltint}%
  \mdfdefinestyle{passignsol}{%
    hidealllines=true, backgroundcolor=passign@soltint,
    leftmargin=-\passign@thmL, rightmargin=0pt,
    innerleftmargin=\passign@thmL, innerrightmargin=\passign@opt@thmboxsep,
    innertopmargin=\passign@opt@thmboxsep,
    innerbottommargin=\passign@opt@thmboxsep,
    skipabove=0pt, skipbelow=0pt}%
  \ifx\passign@opt@solstyle\passign@str@tint
    \def\passign@solframe@begin{\begin{mdframed}[style=passignsol]}%
    \def\passign@solframe@end{\end{mdframed}}%
  \else\ifx\passign@opt@solstyle\passign@str@box
    \def\passign@solframe@begin{\begin{mdframed}[style=passignbox]}%
    \def\passign@solframe@end{\end{mdframed}}%
  \else
    \let\passign@solframe@begin\@empty
    \let\passign@solframe@end\@empty
  \fi\fi
  \newenvironment{solution}[1][]{%
    \par\addvspace{\passign@opt@solbefore}%
    \passign@solframe@begin
    \pushQED{\qed}%
    \noindent
    \passign@leftlabel{\passign@opt@fontthmhead}{\passign@opt@solutionlabel}%
      {\ifpassign@solnumber\passign@curqnum\fi}%
    \ifx\relax##1\relax\else{\passign@opt@fontthmtitle ##1.}\ \fi
    \ignorespaces}%
   {\popQED\passign@solframe@end\par\addvspace{\passign@opt@solafter}}}

\newcommand*\passign@definesolution{%
  \ifpassign@solutions
    \passign@definevisiblesolution
  \else
    \passign@definehiddensolution
  \fi}


%% ----------------------------------------------------------------------
%%  7. Title block
%%
%%      ------------------+-----------------------------
%%              ASSIGNMENT| Title of the assignment
%%                       3  |
%%      ------------------+-----------------------------
%%                  COURSE| MATH 2210 . Linear Algebra
%%                    NAME| Ada Lovelace
%%                     ...|
%%
%%  The big number is drawn in the accent colour; empty keys leave out
%%  their row.
%% ----------------------------------------------------------------------
\gdef\passign@extrafields{}
\newcommand*\addtitlefield[2]{%
  \g@addto@macro\passign@extrafields{\passign@metarow{#1}{#2}}}

% a row: label in the column, value in the text.  An empty value skips it.
\newcommand*\passign@metarow[2]{%
  \protected@edef\passign@mv{#2}%
  \ifx\passign@mv\@empty\else
    \par\nointerlineskip\vskip\passign@opt@metasep
    \noindent\passign@leftlabel{\passign@opt@fontlabel}{#1}{}#2\par
  \fi}

\newcommand*\passign@coursevalue{%
  \passign@opt@coursecode
  \ifx\passign@opt@coursecode\@empty\else
    \ifx\passign@opt@course\@empty\else\space\textperiodcentered\space\fi
  \fi
  \passign@opt@course}
\newcommand*\passign@totalvalue{%
  \ifx\passign@lasttotal\passign@str@zero\else
    \passign@lasttotal\nobreakspace
    \ifx\passign@lasttotal\passign@str@one\passign@opt@markword
    \else\passign@opt@markswords\fi
  \fi}

\newcommand*\passign@titlerow{%
  \setbox\passign@bxa\vtop{\hsize=\dimexpr\passign@bsplit-\passign@pad\relax
    \raggedleft \parindent\z@
    \ifx\passign@opt@number\@empty\else
      {\passign@opt@fontlabel\passign@opt@case{\passign@opt@assignmentlabel}\par}%
      \nointerlineskip\vskip 1.5mm
      {\color{passign@accent}\passign@opt@fontbignum\passign@opt@number\par}%
    \fi}%
  \setbox\passign@bxb\vtop{\hsize=\textwidth
    \raggedright \parindent\z@
    {\passign@opt@fonttitle\passign@opt@title\par}}%
  \nointerlineskip
  \hbox to\z@{\hskip-\passign@bodyleft
    \hbox to\passign@fulltw{%
      \box\passign@bxa
      \hskip\dimexpr\passign@bodyleft-\passign@bsplit+\passign@pad\relax
      \box\passign@bxb\hss}\hss}%
  \nointerlineskip}

\renewcommand*\maketitle{%
  \par
  \begingroup
    \parindent\z@ \parskip\z@
    \passign@hrule
    \nobreak\vskip\passign@opt@titlebefore
    \passign@titlerow
    \nobreak\vskip\passign@opt@titleafter
    \passign@hrule
    \passign@metarow{\passign@opt@courselabel}{\passign@coursevalue}%
    \passign@metarow{\passign@opt@termlabel}{\passign@opt@term}%
    \passign@metarow{\passign@opt@authorlabel}{\passign@opt@author}%
    \passign@metarow{\passign@opt@idlabel}{\passign@opt@studentid}%
    \passign@metarow{\passign@opt@instructorlabel}{\passign@opt@instructor}%
    \passign@metarow{\passign@opt@duelabel}{\passign@opt@due}%
    \passign@metarow{\passign@opt@totallabel}{\passign@totalvalue}%
    \passign@extrafields
    \par
  \endgroup
  \vskip\passign@opt@titleskip}
\let\makeassignmenttitle\maketitle


%% ----------------------------------------------------------------------
%%  8. Page number and running text in the outer margin
%%
%%      page number  (top of the margin)
%%
%%      R U N N I N G   T E X T   (reads downwards, tops of the letters
%%                                  point to the paper edge)
%%
%%  A solid bar of the accent colour runs down the whole outer margin
%%  behind them (`margin bar width').  With twoside the margin is the right
%%  one on odd pages and the left one, mirrored, on even pages.
%% ----------------------------------------------------------------------
% The bar: full paper height, centred on x=\passign@bx, \passign@mw wide when `auto'.
\newcommand*\passign@drawbar{%
  \ifx\passign@opt@barwidth\passign@str@none\else
    \ifx\passign@opt@barwidth\passign@str@auto
      \passign@bw=\passign@mw
    \else
      \passign@bw=\passign@opt@barwidth\relax
    \fi
    \passign@bh=\dimexpr1in+\voffset+\topmargin+\headheight\relax
    \rlap{\hskip\dimexpr\passign@bx-\passign@bw/2\relax
          \smash{{\color{passign@accent}%
            \vrule width\passign@bw height\passign@bh
                   depth\dimexpr\paperheight-\passign@bh\relax}}}%
  \fi}

% #1 = +1: outer margin on the right, -1: on the left
\newcommand*\passign@marginside[1]{%
  \ifnum#1>\z@
    \setbox\passign@rbox\hbox{\rotatebox[origin=c]{-90}{\box\passign@mbox}}%
    \passign@mw=\dimexpr\paperwidth-\passign@fulltw-\passign@fullside-1in-\hoffset\relax
    \passign@bx=\dimexpr\passign@fulltw-\passign@bodyleft+\passign@mw/2\relax
    \passign@mx=\dimexpr\passign@bx+\passign@opt@marginshift\relax
  \else
    \setbox\passign@rbox\hbox{\rotatebox[origin=c]{90}{\box\passign@mbox}}%
    \passign@mw=\dimexpr\passign@fullside+1in+\hoffset\relax
    \passign@bx=\dimexpr-\passign@mw/2-\passign@bodyleft\relax
    \passign@mx=\dimexpr\passign@bx-\passign@opt@marginshift\relax
  \fi
  \passign@drawbar
  \rlap{\hskip\dimexpr\passign@mx-\wd\passign@nbox/2\relax
        \smash{\lower\dimexpr\headsep+\ht\passign@nbox\relax\box\passign@nbox}}%
  \rlap{\hskip\dimexpr\passign@mx-\wd\passign@rbox/2\relax
        \smash{\lower\dimexpr\headsep+\ht\passign@nbox+\passign@opt@margingap
                             +\ht\passign@rbox\relax\box\passign@rbox}}}

% The grid of a page, drawn from the header (everything is placed relative
% to the left edge of the text, hence the negative skips): the divider from
% the top of the paper to just below the footer, the footer rule across the
% full block (broken around the divider) and the footer text left of the
% divider.
\newcommand*\passign@pageframe{%
  \passign@bh=\dimexpr1in+\voffset+\topmargin+\headheight\relax
  \passign@fr=\dimexpr\headsep+\textheight+\passign@bodybot\relax
  \rlap{\hskip\dimexpr\passign@bsplit-\passign@bodyleft\relax
        \smash{\vrule width\passign@rule height\passign@bh
                      depth\dimexpr\passign@fr+\footskip+1.5mm\relax}}%
  \rlap{\hskip-\passign@bodyleft
        \smash{\lower\passign@fr
          \passign@gaprulew{\passign@fulltw}{\z@}{\passign@fulltw}{\passign@bsplit}}}%
  \rlap{\hskip-\passign@bodyleft
        \smash{\lower\dimexpr\passign@fr+\footskip\relax
          \hbox to\passign@bsplit{\hss\passign@label{\passign@opt@footertext}%
                                  \hskip\passign@pad}}}}

\newcommand*\passign@marginhead{%
  \passign@pageframe
  \setbox\passign@nbox\hbox{\passign@opt@fontmarginpage\thepage}%
  \setbox\passign@mbox\hbox{\passign@opt@fontmargin\passign@opt@case{\passign@opt@margintext}}%
  \ifdim\wd\passign@mbox=\z@
    \setbox\passign@mbox\hbox{\passign@opt@fontmargin\passign@opt@case{\passign@opt@title}}%
  \fi
  \ifdim\wd\passign@mbox=\z@
    \setbox\passign@mbox\hbox{\passign@opt@fontmargin\passign@opt@case{\jobname}}%
  \fi
  \if@twoside
    \ifodd\c@page \passign@marginside\@ne \else \passign@marginside\m@ne \fi
  \else \passign@marginside\@ne \fi}

\newcommand*\ps@passign{%
  \let\@mkboth\@gobbletwo
  \def\@oddhead{\passign@marginhead}\let\@evenhead\@oddhead
  \def\@oddfoot{}\let\@evenfoot\@oddfoot}


%% ----------------------------------------------------------------------
%%  9. Sections (optional grouping of questions)
%%
%%      ------------------+-----------------------------   hairline, broken
%%             SECTION  1 | Title of the section             around the divider
%%
%%  The label stands in the column, flush against the divider; the title
%%  is in `section font'.  \subsection has the number in the label column
%%  and no hairline.  Sections do not number the questions.
%% ----------------------------------------------------------------------
% (robust: \@sect expands these with \protected@edef, which must not touch
% the font switches inside)
\DeclareRobustCommand*\passign@seclabel{%
  \passign@leftlabel{\passign@opt@fontsecnum}{\passign@opt@sectionlabel}{\thesection}}
\DeclareRobustCommand*\passign@subseclabel{%
  \passign@leftlabel{\passign@opt@fontsecnum}{}{\thesubsection}}
\expandafter\def\csname passign@seccnt@section\endcsname{\passign@seclabel}
\expandafter\def\csname passign@seccnt@subsection\endcsname{\passign@subseclabel}
\let\passign@oldseccntformat\@seccntformat
\renewcommand*\@seccntformat[1]{%
  \@ifundefined{passign@seccnt@#1}%
    {\passign@oldseccntformat{#1}}%
    {\csname passign@seccnt@#1\endcsname}}
% The hairline above a section title: across the full block, broken around
% the divider.  Runs in the heading's own group, before its first line.
\newcommand*\passign@secrule{%
  \passign@hrule
  \nobreak\vskip\passign@opt@secpad \nointerlineskip}
\newcommand*\passign@sectionstyle{\passign@secrule\raggedright\passign@opt@fontsection}
\newcommand*\passign@subsectionstyle{\raggedright\passign@opt@fontsubsection}
\renewcommand\section{\@startsection{section}{1}{\z@}%
  {-\passign@opt@secbefore}{\passign@opt@secafter}{\passign@sectionstyle}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}%
  {-1.5\baselineskip plus 0.3\baselineskip minus 0.2\baselineskip}%
  {0.6\baselineskip}{\passign@subsectionstyle}}


%% ----------------------------------------------------------------------
%%  10. Margin notes, sidenotes, footnotes in the label column
%%
%%      \marginnote[offset]{text}   unnumbered
%%      \sidenote[offset]{text}     numbered (restarts in every question)
%%      footnotes = margin          makes \footnote = \sidenote, with the
%%                                  text in `footnote font' (italic)
%%
%%  The notes stand in the column left of the divider (\reversemarginpar),
%%  flush left, as wide as the column less `note gap'.
%%  Limits: built on \marginpar, so not inside floats, minipages, section
%%  titles or the boxed/tinted environments (theorem boxes, solutions in
%%  `tint' or `box' style).  Assumes oneside.  A note and a label at the
%%  same height will overlap: move the note with the offset.
%% ----------------------------------------------------------------------
\reversemarginpar
\newcommand*\passign@notestyle{%
  \renewcommand\baselinestretch{1}%
  \passign@opt@fontnote \raggedright \parindent\z@ \parskip\z@}

% offset #1 (down = +), material #2; keeps the first baseline on the text line
\newcommand\passign@noteput[2]{%
  \noindent
  \setbox\z@\vtop{\hsize=\marginparwidth \passign@notestyle #2\par}%
  \raisebox{-#1}[\ht\z@][\dp\z@]{\box\z@}}

\newcommand\marginnote[2][\z@]{\marginpar{\passign@noteput{#1}{#2}}}

\newcounter{sidenote}
\@addtoreset{sidenote}{question}
% #1 = offset, #2 = font switch for the text (may be empty), #3 = text.
% The number stays upright in both places.
\newcommand\passign@sidenote[3]{%
  \stepcounter{sidenote}%
  \edef\passign@sn{\thesidenote}%
  \textsuperscript{\passign@sn}%
  \marginpar{\passign@noteput{#1}{\textsuperscript{\passign@sn}\nobreakspace {#2#3}}}}
\newcommand\sidenote[2][\z@]{\passign@sidenote{#1}{}{#2}}
\newcommand\passign@footnote[2][\z@]{\passign@sidenote{#1}{\passign@opt@fontfootnote}{#2}}

% Ordinary footnotes: the text goes through `footnote font', the mark does not.
\newcommand*\passign@italicfootnotes{%
  \let\passign@oldmakefntext\@makefntext
  \long\def\@makefntext##1{\passign@oldmakefntext{\passign@opt@fontfootnote ##1}}}


%% ----------------------------------------------------------------------
%%  11. Theorem-like environments
%%
%%  Four amsthm styles:
%%    passignplain    italic, no box          passignplainup  upright, no box
%%    passignbox      italic, boxed           passignboxup    upright, boxed
%%  The box is a square hairline box (mdframed) hanging on the divider: the
%%  top and bottom rules stop short of it by `rule gap', the divider is the
%%  left side.  The text inside is aligned with the text outside.
%%  In all of them the name and number stand in the label column, like the
%%  label of a section (`theorem head font'), and the optional title is run
%%  into the text, in bold.
%% ----------------------------------------------------------------------
\newskip\passign@thmskip
\newlength\passign@thmL   % how far the box reaches left of the text

% The title is run into the text, in bold, followed by a full stop.  (amsthm
% drops \thmnote when there is no title.)
\newcommand*\passign@thmtitle[1]{\thmnote{{\passign@opt@fontthmtitle #1.}\ }}
% #1 = name, #2 = number (empty for the starred forms), #3 = title
\newcommand*\passign@thmhead[3]{%
  \passign@leftlabel{\passign@opt@fontthmhead}{#1}{#2}\passign@thmtitle{#3}}

\newcommand*\passign@definetheorems{%
  \newtheoremstyle{passignplain}%
    {\passign@thmskip}{\passign@thmskip}{\itshape}{0pt}{}{}{0pt}%
    {\passign@thmhead{##1}{##2}{##3}}%
  \newtheoremstyle{passignplainup}%
    {\passign@thmskip}{\passign@thmskip}{\normalfont}{0pt}{}{}{0pt}%
    {\passign@thmhead{##1}{##2}{##3}}%
  % the box brings its own space above and below
  \newtheoremstyle{passignbox}%
    {0pt}{0pt}{\itshape}{0pt}{}{}{0pt}%
    {\passign@thmhead{##1}{##2}{##3}}%
  \newtheoremstyle{passignboxup}%
    {0pt}{0pt}{\normalfont}{0pt}{}{}{0pt}%
    {\passign@thmhead{##1}{##2}{##3}}%
  % one counter for everything, reset in every question
  \theoremstyle{passignbox}%
  \newtheorem{theorem}{Theorem}[question]
  \newtheorem*{theorem*}{Theorem}%
  \newtheorem{lemma}[theorem]{Lemma}%
  \newtheorem*{lemma*}{Lemma}%
  \surroundwithmdframed[style=passignbox]{theorem}%
  \surroundwithmdframed[style=passignbox]{theorem*}%
  \surroundwithmdframed[style=passignbox]{lemma}%
  \surroundwithmdframed[style=passignbox]{lemma*}%
  \theoremstyle{passignboxup}%
  \newtheorem{definition}[theorem]{Definition}%
  \newtheorem*{definition*}{Definition}%
  \surroundwithmdframed[style=passignbox]{definition}%
  \surroundwithmdframed[style=passignbox]{definition*}%
  \theoremstyle{passignplain}%
  \newtheorem{proposition}[theorem]{Proposition}%
  \newtheorem*{proposition*}{Proposition}%
  \newtheorem{corollary}[theorem]{Corollary}%
  \newtheorem*{corollary*}{Corollary}%
  \theoremstyle{passignplainup}%
  \newtheorem{example}[theorem]{Example}%
  \newtheorem*{example*}{Example}%
  \newtheorem{remark}[theorem]{Remark}%
  \newtheorem*{remark*}{Remark}%
  \newtheorem{hint}[theorem]{Hint}%
  \newtheorem*{hint*}{Hint}%
  \newtheorem{note}[theorem]{Note}%
  \newtheorem*{note*}{Note}%
  % the proof is labelled in the column too
  \renewenvironment{proof}[1][\proofname]{%
    \par\pushQED{\qed}\normalfont
    \topsep=\passign@thmskip \partopsep=\z@
    \trivlist\item[]\leavevmode
    \passign@leftlabel{\passign@opt@fontthmhead}{##1}{}%
    \ignorespaces}%
    {\popQED\endtrivlist\@endpefalse}}


%% ----------------------------------------------------------------------
%%  12. Everything that needs the geometry: at \begin{document}
%% ----------------------------------------------------------------------
\AtBeginDocument{%
  % the geometry as set by the user is the FULL layout
  \passign@fulltw=\textwidth
  \passign@fullth=\textheight
  \passign@fulltopm=\topmargin
  \passign@fullodd=\oddsidemargin
  \passign@fulleven=\evensidemargin
  \colorlet{passign@num}{\passign@opt@numcolour}%
  \passign@pad=\passign@opt@labelpad\relax
  \passign@rule=\passign@opt@rule\relax
  \passign@gap=\passign@opt@rulegap\relax
  \passign@bsplit=\passign@opt@bodysplit\relax
  \passign@bodygap=\passign@opt@bodygap\relax
  \passign@bodyleft=\dimexpr\passign@bsplit+\passign@bodygap\relax
  \passign@bodyright=\passign@opt@bodyright\relax
  \passign@bodytop=\passign@opt@bodytop\relax
  \passign@bodybot=\passign@opt@bodybottom\relax
  \passign@bodytw=\dimexpr\passign@fulltw-\passign@bodyleft-\passign@bodyright\relax
  \passign@thmskip=\passign@opt@thmskip\relax
  \passign@thmL=\dimexpr\passign@bodygap-\passign@opt@rule-\passign@opt@rulegap\relax
  % margin notes fill the label column, up to `note gap' from the divider
  \marginparwidth=\dimexpr\passign@bsplit-\passign@opt@notegap\relax
  \marginparsep=\dimexpr\passign@bodygap+\passign@opt@notegap\relax
  \marginparpush=2mm
  \ifx\passign@opt@footnotes\passign@str@margin \let\footnote\passign@footnote \fi
  \ifx\footnote\passign@footnote\else \passign@italicfootnotes \fi
  \passign@bodylayout
  % the boxes (also used for solutions in `box' style)
  \mdfdefinestyle{passignbox}{%
    linecolor=passign@ink, linewidth=\passign@opt@rule, roundcorner=0pt,
    leftline=false,
    leftmargin=-\passign@thmL, rightmargin=0pt,
    innerleftmargin=\passign@thmL, innerrightmargin=\passign@opt@thmboxsep,
    innertopmargin=\passign@opt@thmboxsep,
    innerbottommargin=\dimexpr\passign@opt@thmboxsep*2/5\relax,
    skipabove=\passign@thmskip, skipbelow=\passign@thmskip}%
  \ifx\passign@opt@theorems\passign@str@off\else \passign@definetheorems \fi
  \passign@definesolution
  \renewcommand*\qedsymbol{\passign@qedsquare}%
  \pagestyle{passign}}

\endinput
