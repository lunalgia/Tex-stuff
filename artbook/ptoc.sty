%% ======================================================================
%%  ptoc.sty  v2.7  --  print-on-demand-catalogue style book structure
%%
%%  Requires LuaLaTeX or XeLaTeX (fontspec), graphicx, and the book (or
%%  report) class.  Build three times: .toc, then the part / chapter pages
%%  (they read the .toc), then hyperlinks.
%%
%%  Structure           in the table of contents         on its own page
%%  ------------------  -------------------------------  ---------------------
%%  \part{...}          big coloured heading, full rule  full-colour part page
%%                      (title only, no part number)     with a mini contents
%%                                                       listing its chapters
%%  \chapter{...}       "1  TITLE" label, middle column  opener: huge number,
%%                                                       grid, section list,
%%                                                       epigraph, title
%%  \section{...}       row: "SECTION 1.2" above the title + page number
%%
%%  In the TOC only the divider between chapters and sections breaks the
%%  horizontal rules; the other two vertical lines run through unbroken.
%%  The TOC may run over several pages.  On ordinary pages the page number
%%  and a running text (chapter title) stand vertically in the outer margin,
%%  on a solid bar of the accent colour.
%%
%%  Ordinary pages use the grid of the chapter openers: a hairline divider
%%  (at the same x as on the chapter page) with a column of small labels to
%%  its left and the text to its right.  The column holds the section label
%%  (SECTION 1.2), the names of theorems, and the margin notes and footnotes.
%%  A section starts with a hairline across the page, broken around the
%%  divider like the rules of the TOC; the label sits under it, the title
%%  to the right.  A footer rule closes the page.
%%
%%  Commands
%%     \ptocsetup{key=value, ...}   configure (keys below)
%%     \sectionpages{34--37}        before a \section: override its page number
%%     \chapterepigraph{quote}{source}   before a \chapter: epigraph on its page
%%     \marginnote[offset]{text}    unnumbered note in the right margin
%%     \sidenote[offset]{text}      numbered note in the right margin
%%                                  (offset: + moves down, - moves up)
%%
%%  Theorem-like environments (amsthm, defined at \begin{document})
%%     theorem  lemma  definition      plain amsthm style, in a square box
%%     example  remark                 plain amsthm style, in a rule-only box:
%%                                     top and bottom rule, no right side,
%%                                     running out to the margin bar
%%     proposition  corollary  question  proof
%%                                     plain amsthm style, no box
%%     Each also exists unnumbered:  theorem*  lemma*  definition*  ...
%%     All numbered ones share one counter, reset in every \section.
%%     The name and number (THEOREM 1.2.3) stand in the label column left
%%     of the divider; the optional title  \begin{theorem}[Title]  stays in
%%     the text, in bold.  A box hangs on the divider like a cell of the TOC.
%%     `theorems = off' skips all of this (use it if the document defines
%%     its own theorems).
%%
%%  Keys (defaults in brackets)
%%   TOC layout   split          x of the main divider           [0.5\textwidth]
%%                sub split      x of the chapter-column divider [0.25\textwidth]
%%                page width     width of the page-number column [10mm]
%%                padding        space next to rules             [2mm]
%%                chapter pad    space between the chapter name  [4mm]
%%                               in the TOC and the vertical rules
%%                rule           rule thickness                  [0.5pt]
%%                rule gap       white gap on each side of the   [0.8mm]
%%                               chapter/section divider (0pt = no break)
%%                top padding    row with number: space above    [2.6mm]
%%                bottom padding row with number: space below    [2.2mm]
%%                plain padding  row without number: centred     [2.6mm]
%%                top space      space above the first rule      [8mm]
%%                part shift     raise (+) / lower (-) heading   [-0.3mm]
%%                label shift    raise running label             [1mm]
%%   TOC text     contents label text of the small top label     [Table of Contents]
%%                section label  word before the section number  [Section]
%%                               (empty = number only)
%%                footer text    text left of the page number    [the \title]
%%                               (the job name if there is no \title)
%%                label case     \MakeUppercase, or empty        [\MakeUppercase]
%%                body page style page style after the TOC       [ptocbody]
%%   links        link toc       hyperref: page | all | none     [page]
%%                link style     code run inside the TOC         [no boxes/colours]
%%   part pages   part logo      any code (empty = none)         [concentric squares]
%%                part label     word before the part number on  [empty = none]
%%                               the part page, e.g. "Part"
%%                mini width     width of the chapter list       [0.5\textwidth]
%%                mini rule      thickness of its two rules      [1.5pt]
%%                mini gap       space between chapters          [3.5mm]
%%                badge size     diameter of the number badge    [5.6mm]
%%   chapter      chapter label  word before the chapter number  [Chapter]
%%   pages        chapter split  x of the divider                [0.25\textwidth]
%%                chapter rule 1 y of the upper rule (from the   [0.30\textheight]
%%                               top of the text block)
%%                chapter rule 2 y of the rule above the title;  [0.58\textheight]
%%                               the number stands on it
%%                chapter drop   lowers rules, number, section   [8mm]
%%                               list, title and epigraph together
%%                chapter shift  raise (+) / lower (-) the       [-0.3mm]
%%                               number relative to rule 2
%%                chapter number x
%%                               left edge of the number, measured from
%%                               the PAPER edge; negative = cut off by
%%                               the page edge                   [-2mm]
%%                epigraph x     x of the epigraph               [0.5\textwidth]
%%   ordinary     The TOC, part pages and chapter openers use the full text
%%   pages        block set in the geometry.  Ordinary pages are set in a
%%                smaller block inside it:
%%                body split     x of the divider (= the label     [= chapter split]
%%                               column's width)
%%                body gap       space between divider and text  [5mm]
%%                body right     space between text and the      [6mm]
%%                               outer margin strip
%%                body top       extra space above the text      [6mm]
%%                body bottom    extra space below the text      [10mm]
%%                body leading   \linespread of ordinary pages   [1.2]
%%   sections     section label  word before the section number  [Section]
%%                               (shared with the TOC)
%%                section before / section after   vertical space
%%                               [2.4\baselineskip plus .. / 1.2\baselineskip]
%%                section pad    space between the hairline and  [2.2mm]
%%                               the title
%%                section font   the title (complete font        [serif 15/18pt]
%%                               switch: family, size, shape)
%%                section number font  the label in the column   [label font]
%%                               (complete font switch)
%%                subsection font  the title of a \subsection     [bold serif 10pt]
%%   margin       margin text    running text, any code          [\leftmark = chapter
%%                               (\rightmark = section)           title, or the part
%%                                                                title, or the
%%                                                                document title]
%%                margin gap     space between number and text   [6mm]
%%                margin shift   move both towards the paper     [0pt]
%%                               edge (+) or the text block (-)
%%                margin bar width  width of the accent-coloured [auto]
%%                               bar behind number and text:
%%                               auto = the whole outer margin,
%%                               a length, or none
%%   notes        note gap       space between notes and the     [4mm]
%%                               divider; the notes fill the
%%                               column left of it
%%                note font      font of the notes               [8pt serif]
%%                footnotes      margin | normal  (margin turns  [margin]
%%                               \footnote into \sidenote)
%%                footnote font  applied to the text of          [\itshape]
%%                               footnotes (not to \marginnote)
%%   theorems     theorems       on | off                        [on]
%%                theorem head font   name and number in the     [label font]
%%                               label column (complete switch)
%%                theorem title font  the [Title] in the text    [\bfseries]
%%                theorem box sep     space between box and text [2.5mm]
%%                theorem skip   space above and below           [9pt plus 2pt
%%                                                                 minus 2pt]
%%   colours      accent         background of part pages, TOC headings,
%%                               chapter numbers, margin bar
%%                ink            text colour on part pages
%%   fonts        part font        big heading in the TOC
%%                label font       small mono labels (TOC, footer, chapter pages)
%%                number font      section number above a title in the TOC
%%                title font       section titles in the TOC
%%                page font        page numbers
%%                part label font  "Part I" on the part page
%%                part title font  huge title on the part page
%%                mini font        chapter titles in the mini contents
%%                badge font       number inside the round badge next to them
%%                chapter number font  huge number on a chapter page
%%                chapter title font   title on a chapter page
%%                epigraph font        epigraph on a chapter page
%%                section font         section title on ordinary pages
%%                section number font  section number on ordinary pages
%%                margin font          running text in the margin
%%                margin page font     page number in the margin
%%                note font            margin notes
%%                -- each is arbitrary code that switches font, usually
%%                   \fontspec[Ligatures=TeX]{...} then \fontsize{..}{..}\selectfont
%% ======================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ptoc}[2026/10/02 v2.7 print-on-demand style book structure]

\RequirePackage{fontspec}
\RequirePackage{xcolor}
\RequirePackage{pgfkeys}
\RequirePackage{pict2e}
\RequirePackage{graphicx}   % \rotatebox for the margin text, \raisebox
\RequirePackage{amsthm}     % theorem-like environments (section 12)
\RequirePackage{mdframed}   % the boxes around theorems, lemmas, definitions

% the report class has no front/main matter switch: treat it as main matter
\@ifundefined{if@mainmatter}{\newif\if@mainmatter \@mainmattertrue}{}


%% ----------------------------------------------------------------------
%%  1. Options and their defaults
%% ----------------------------------------------------------------------
\definecolor{ptoc@default}{HTML}{FFC400}
\definecolor{ptoc@inkdefault}{HTML}{1F1B1D}

% Default fonts (TeX Gyre ships with TeX Live; fall back to the standard
% families if it is missing).  Replace them freely via the font keys.
\newcommand*\ptoc@sans{%
  \IfFontExistsTF{TeX Gyre Heros}{\fontspec[Ligatures=TeX]{TeX Gyre Heros}}{\sffamily}%
  \bfseries}
\newcommand*\ptoc@serif{%
  \IfFontExistsTF{TeX Gyre Pagella}{\fontspec[Ligatures=TeX]{TeX Gyre Pagella}}{\rmfamily}}
\newcommand*\ptoc@mono{%
  \IfFontExistsTF{TeX Gyre Cursor}%
    {\fontspec[Ligatures=TeX,LetterSpace=12]{TeX Gyre Cursor}}{\ttfamily}}

\pgfkeys{/ptoc/.cd,
