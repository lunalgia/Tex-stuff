  chapter label/.store in  = \ptoc@opt@chapterlabel,
  chapter split/.store in  = \ptoc@opt@chapsplit,
  chapter rule 1/.store in = \ptoc@opt@chapruleone,
  chapter rule 2/.store in = \ptoc@opt@chapruletwo,
  chapter shift/.store in  = \ptoc@opt@chapshift,
