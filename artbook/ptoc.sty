  margin bar width/.store in = \ptoc@opt@barwidth,
  % --- margin notes
  note gap/.store in       = \ptoc@opt@notegap,
  footnotes/.store in      = \ptoc@opt@footnotes,
  footnote font/.store in  = \ptoc@opt@fontfootnote,
  % --- theorem-like environments
  theorems/.store in       = \ptoc@opt@theorems,
  theorem head font/.store in  = \ptoc@opt@fontthmhead,
  theorem title font/.store in = \ptoc@opt@fontthmtitle,
  theorem box sep/.store in    = \ptoc@opt@thmboxsep,
  theorem skip/.store in       = \ptoc@opt@thmskip,
