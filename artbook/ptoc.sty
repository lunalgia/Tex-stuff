  part shift/.store in     = \ptoc@opt@partshift,
  label shift/.store in    = \ptoc@opt@labelshift,
  rule gap/.store in       = \ptoc@opt@rulegap,
  % --- TOC text
  contents label/.store in = \ptoc@opt@contentslabel,
  section label/.store in  = \ptoc@opt@sectionlabel,
