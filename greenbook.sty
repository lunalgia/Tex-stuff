%% greenbook.sty
%% Book style built on memoir: layout.tex, environments.tex and
%% packages-macros.tex merged into one package.
%%
%% Usage (LuaLaTeX):
%%   \documentclass[a4paper, 10pt, twoside, openany]{memoir}
%%   \usepackage{greenbook}
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{greenbook}[2026/10/05 greenbook book style]

\@ifclassloaded{memoir}{}{%
  \PackageError{greenbook}{greenbook needs the memoir class}%
    {Use \string\documentclass[a4paper, 10pt, twoside, openany]{memoir}.}}

