%hyperref setup
\RequirePackage[linktoc=page,hyperfootnotes=false]{hyperref}
\hypersetup{
colorlinks=true,
linkcolor=hkgreen,
citecolor=hkgreen,
urlcolor=hkgreen,
}
% text styling of all side footnotes
% styling and placement of mark
\footmarkstyle{{\itshape#1. }}
\setlength{\footmarkwidth}{0em}
\setlength{\footmarksep}{-\footmarkwidth}

% memoir command - do all footnotes in margin
% don't use memoir's built-in mechanism
% (remove \footnotesinmargin)

\renewcommand{\footnote}[2][0pt]{%
  \refstepcounter{footnote}%
  \textsuperscript{\thefootnote}%
  \marginnote{\footnotesize{\itshape\thefootnote. }#2}[#1]%
}
% SIDECAPTIONS
\setsidecaps{\marginparsep}{\marginparwidth}
\sidecapmargin{outer}
\setsidecappos{t}
\renewcommand*{\sidecapstyle}{%
\captionnamefont{\scshape}
\ifscapmargleft
\captionstyle{\RaggedLeft\footnotesize\foottextfont}%
\else
\captionstyle{\RaggedRight\footnotesize\foottextfont}%
\fi}

  \renewcommand{\fnum@figure}{
  {\small\bfseries\scshape\figurename~\thefigure}}

\renewcommand{\footnotesize}{\fontsize{9pt}{12pt}\selectfont} % Change footnotesize to 10pt

